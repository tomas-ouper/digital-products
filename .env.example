# Código de acceso que se entrega a quien compra (OTO 2).
# En Vercel: Settings → Environment Variables → VITE_ACCESS_CODE
# Si no se define, se usa el código por defecto "CALIGRAFIA".
VITE_ACCESS_CODE=CALIGRAFIA
# Minutos de juego por día por perfil (los padres pueden cambiarlo en el panel)
VITE_DAILY_LIMIT_MIN=20
